date-released: "2026-10-15"
license: BSD-3-Clause
url: "https://polyxios.org"
repository-code: "https://github.com/fury-gl/polyxios"
keywords:
  - mesh
  - point cloud
  - 3D
  - file formats
  - I/O
  - scientific computing
